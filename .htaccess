# ====== ANXIE STORE — HOSTINGER ======
# Hostinger publica en public_html todo lo que hay en el repo. Los archivos
# internos ya salieron de git, pero los despliegues viejos pueden haberlos
# dejado ahí: estas reglas los esconden aunque sigan en el servidor.

# 🚫 Archivos ocultos (.gitignore, etc.) e internos por extensión
#    (documentación, config, textos, scripts)
<FilesMatch "(^\.|\.(md|toml|txt|log|bak|py|sh|ps1|env)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# 🚫 Carpetas internas: responden 404, como si no existieran
<IfModule mod_alias.c>
  RedirectMatch 404 ^/(worker|EJEMPLOS|maquetas-s2|_privado|_respaldo[^/]*|_scripts|venv|\.vscode|\.claude|\.wrangler|\.git)(/|$)
</IfModule>

# 🔗 URLs limpias (24 septiembre 2026): anxiestore.com/catalogo y /legal en vez
#    de /catalogo.html y /legal.html, y el inicio siempre en anxiestore.com/.
#    Los archivos no se mueven: la dirección limpia sirve el .html de siempre.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Las direcciones viejas (enlaces guardados, Google, el HTML en caché)
  # llevan a la limpia con un 301. %{THE_REQUEST} es lo que pidió el
  # navegador, no la reescritura interna de abajo: sin esa condición el
  # 301 y la reescritura se perseguirían en bucle.
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?]
  RewriteRule ^index\.html$ / [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+(catalogo|legal)\.html[\s?]
  RewriteRule ^(catalogo|legal)\.html$ /$1 [R=301,L]

  # Con barra final, style.css y assets/ se buscarían dentro de /catalogo/.
  RewriteRule ^(catalogo|legal)/$ /$1 [R=301,L]

  RewriteRule ^(catalogo|legal)$ $1.html [L]
</IfModule>

# 🛡️ Cabeceras de seguridad
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
